# Cloudflare Pages — politica di cache.
#
# main.dart.js e flutter_bootstrap.js NON hanno un hash nel nome: se il browser
# li tiene in cache, dopo un deploy continua a eseguire il bundle vecchio contro
# il database nuovo. E' il caso classico in cui "ho fatto il deploy" e non
# cambia niente. Questi file si rivalidano sempre.
/index.html
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache

# Gli asset hanno il contenuto versionato dal build: si possono tenere a lungo.
/assets/*
  Cache-Control: public, max-age=604800
/canvaskit/*
  Cache-Control: public, max-age=604800

# Sicurezza per tutte le pagine (audit 2026-09-22).
# - nessuno puo' incorniciare PitLap in un iframe (clickjacking sulle azioni admin)
# - il browser ricorda per un anno di usare solo HTTPS
# Una CSP completa per Flutter web (canvaskit da gstatic, wasm, immagini da siti
# terzi) va progettata a parte: qui si blocca solo l'incorniciamento.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
