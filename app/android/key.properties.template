# Firma release PitLap — COPIA questo file in "key.properties" (stessa cartella)
# e compila i valori reali. NON committare key.properties né il file .jks.
#
# 1) Genera il keystore (una volta sola, tienilo al sicuro: se lo perdi non puoi
#    più aggiornare l'app su Play). Da app/android/app/ esegui:
#
#      keytool -genkey -v -keystore pitlap-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias pitlap
#
# 2) Metti pitlap-release.jks in app/android/app/ e compila i campi sotto.
# 3) Copia questo file in app/android/key.properties.
#
storePassword=LA_TUA_PASSWORD_STORE
keyPassword=LA_TUA_PASSWORD_CHIAVE
keyAlias=pitlap
storeFile=pitlap-release.jks
